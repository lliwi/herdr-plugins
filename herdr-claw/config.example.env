# Copia esto a `$(herdr plugin config-dir claw)/.env` y rellena el token.
#
# URL del gateway de OpenClaw. Vale la que usas en el navegador: la ruta sobra,
# el protocolo va por websocket contra la raíz del mismo puerto.
CLAW_URL=http://openclaw.home:18789

# Token del gateway: el mismo que se pega en Control UI → Settings → Connection,
# o el que imprime `openclaw doctor --generate-gateway-token` dentro del docker.
CLAW_TOKEN=

# Sesión que abre el panel al arrancar. `main` es la que sale en /chat/main.
# CLAW_SESSION=main
